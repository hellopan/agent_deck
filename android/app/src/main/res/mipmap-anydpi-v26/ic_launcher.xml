<?xml version="1.0" encoding="utf-8"?>
<!-- API 26+ launcher icon. The foreground is a 108dp canvas with the mark at
     60% (inside the 66dp safe zone), so circle/squircle/teardrop masks never
     clip its rounded corners. Keep this in sync with ic_launcher_round.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
